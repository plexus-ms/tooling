services:
  web:
    image: ${PLEXUS_DEPLOYMENT_IMAGE:?rendered by the deploy verb}
    restart: unless-stopped
    environment:
      NODE_ENV: production
      # What the deployment says about itself, pinned by the deploy verb (PLX-Releases): the display version,
      # where the repo has them, and the commit it was started from. Empty where none is handed over.
      PLEXUS_DISPLAY_VERSION: ${PLEXUS_DISPLAY_VERSION:-}
      PLEXUS_COMMIT_SHA: ${PLEXUS_COMMIT_SHA:-}
    env_file:
      - path: .env
        required: false
      - path: .env.secret
        required: false
    ports:
      - "127.0.0.1:${PLEXUS_LOOPBACK_PORT:?set by the platform playbook}:3000"
    labels:
      plexus.tenant: {{ tenant }}
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - "fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 60s
      start_interval: 1s
{%- if profile == "stateful" %}

  migrate:
    image: ${PLEXUS_DEPLOYMENT_IMAGE:?rendered by the deploy verb}
    profiles: ["migrate"]
    # npm, not pnpm: the image holds node and the standalone build and nothing else.
    entrypoint: ["npm", "run", "migrate"]
    environment:
      NODE_ENV: production
    env_file:
      - path: .env
        required: false
      - path: .env.secret
        required: false
    labels:
      plexus.tenant: {{ tenant }}

  # Data services go here, each a dependency of web and migrate, with its data in a named volume,
  # never in a bind-mounted directory (§ 9.1 PLX-App).
{%- endif %}
