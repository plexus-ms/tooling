# Managed by Ansible (plexus.platform.ingress) — one route per app record on this host.
# Imported by /etc/caddy/Caddyfile.
# Caddy obtains + renews Let's Encrypt certs automatically for each host
# below (needs DNS → this host and ports 80/443 open).
# One site per host: apps sharing a host each take a path prefix (`path:` in
# the inventory record); an app without one serves the host's root. The
# prefix is stripped before the request reaches the app, so the app serves
# from its own root and learns its public URL from its environment.
#
# /healthz is refused from outside, for every app, root and prefixed alike:
# defence in depth for apps whose healthcheck answers on that conventional
# path, which publicly would tell anyone whether the app's dependencies are
# up. The deploy does not depend on it; it reads the container's health from
# Docker on the host.
{% for host, apps in plexus_apps | groupby('host') %}
{{ host }} {
	encode zstd gzip
{% for app in apps %}
{% if app.path is defined %}
	# {{ app.name }}{% if app.environment is defined %} ({{ app.environment }}){% endif %}, under {{ app.path }}/
	redir {{ app.path }} {{ app.path }}/
	handle_path {{ app.path }}/* {
{% else %}
	# {{ app.name }}{% if app.environment is defined %} ({{ app.environment }}){% endif %}

	handle {
{% endif %}
		respond /healthz 403
		reverse_proxy 127.0.0.1:{{ app.loopback_port }}
	}
{% endfor %}
{% if apps | selectattr('path', 'undefined') | list | length == 0 %}
	# No app serves this host's root.
	handle {
		respond 404
	}
{% endif %}
	# Backend unreachable (deploy rollout, crash, migration window): serve a
	# plain maintenance page instead of a bare 502. Auto-refreshes; Retry-After
	# keeps well-behaved clients polling. Tenants override the copy via
	# ingress_maintenance_lang / _title / _text in their inventory.
	handle_errors {
		@backend_down expression `{err.status_code} in [502, 503, 504]`
		handle @backend_down {
			header Retry-After 120
			header Content-Type "text/html; charset=utf-8"
			respond <<MAINTENANCE
				<!doctype html><html lang="{{ ingress_maintenance_lang | default('en') }}"><head><meta charset="utf-8">
				<meta name="viewport" content="width=device-width, initial-scale=1">
				<meta http-equiv="refresh" content="60">
				<title>{{ ingress_maintenance_title | default('Back in a minute') }}</title>
				<style>body{font-family:system-ui,sans-serif;display:grid;place-items:center;min-height:100vh;margin:0;background:#f8fafc;color:#0f172a}main{text-align:center;padding:2rem;max-width:30rem}h1{font-size:1.4rem;margin-bottom:.5rem}p{color:#475569;line-height:1.5}</style>
				</head><body><main>
				<h1>{{ ingress_maintenance_title | default('Back in a minute') }}</h1>
				<p>{{ ingress_maintenance_text | default('This service is briefly unavailable for maintenance. This page refreshes automatically.') }}</p>
				</main></body></html>
				MAINTENANCE 503
		}
	}
}
{% endfor %}
